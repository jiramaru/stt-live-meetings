# Whisper model: tiny, base, small, medium, large-v3, large-v3-turbo
STT_MODEL_SIZE=small
# cpu or cuda
STT_DEVICE=cpu
# int8 is recommended on CPU, float16 on GPU
STT_COMPUTE_TYPE=int8
# Languages allowed for automatic detection (comma separated)
STT_LANGUAGES=fr,en
# Where finished sessions are stored
STT_DATA_DIR=data
