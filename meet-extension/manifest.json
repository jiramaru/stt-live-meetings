{
  "manifest_version": 3,
  "name": "Transcription Meet",
  "version": "0.1.0",
  "description": "Transcrit les appels Google Meet à partir des sous-titres et envoie le compte rendu aux participants après l'appel.",
  "key": "",
  "permissions": ["storage", "identity", "identity.email", "alarms"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["src/content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["src/transcript.js"], "matches": ["https://meet.google.com/*"] }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "oauth2": {
    "client_id": "REMPLACER_PAR_VOTRE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events.readonly",
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/gmail.send"
    ]
  }
}
